ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-output-of-fernet-generate-key
# 只填域名，不要包含 https://、路径或端口；DNS A 记录需指向云服务器。
APP_DOMAIN=seo.example.com
DATABASE_URL=sqlite:////app/data/backlink_manager.db
SESSION_DAYS=7
COOKIE_SECURE=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
AUTOMATION_BATCH_SIZE=10
AUTOMATION_MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=true
KEYWORD_DISCOVERY_ENABLED=true
KEYWORD_FETCH_INTERVAL_SECONDS=1800
KEYWORD_ENRICHMENT_INTERVAL_SECONDS=900
KEYWORD_ENRICHMENT_BATCH_SIZE=5
KEYWORD_SERPAPI_DAILY_BUDGET=50
KEYWORD_IGNORE_COOLDOWN_DAYS=30
KEYWORD_ANOMALY_RATIO=0.3
KEYWORD_FETCH_MAX_RETRIES=3
KEYWORD_FETCH_MAX_CONCURRENCY=5
KEYWORD_FETCH_REQUEST_DELAY=0.5
# 远程 Claude Code Agent 集成（默认关；配好宿主机 cron + 目录权限后再开）
AGENT_INTEGRATION_ENABLED=false
AGENT_DISPATCH_INTERVAL_SECONDS=1800
AGENT_COLLECT_INTERVAL_SECONDS=300
AGENT_BATCH_SIZE=20
AGENT_QUEUE_DIR=agent_queue
AGENT_REVIEW_COOLDOWN_HOURS=72
AGENT_MIN_SCORE=20
