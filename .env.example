ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-output-of-fernet-generate-key
DATABASE_URL=sqlite:////app/data/backlink_manager.db
SESSION_DAYS=7
COOKIE_SECURE=false
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
AUTOMATION_BATCH_SIZE=10
AUTOMATION_MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=true
KEYWORD_DISCOVERY_ENABLED=true
KEYWORD_FETCH_INTERVAL_SECONDS=1800
KEYWORD_ENRICHMENT_INTERVAL_SECONDS=900
KEYWORD_ENRICHMENT_BATCH_SIZE=5
KEYWORD_SERPAPI_DAILY_BUDGET=50
KEYWORD_IGNORE_COOLDOWN_DAYS=30
